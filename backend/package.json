{
  "name": "trego-backend",
  "version": "1.0.0",
  "description": "Backend API for Trego fitness and nutrition app",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docker:build": "docker build -t trego-backend .",
    "docker:run": "docker run -p 3000:3000 trego-backend",
    "migrate": "node src/scripts/migrate.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "firebase-admin": "^11.11.1",
    "axios": "^1.6.0",
    "openai": "^4.20.1",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "nodemailer": "^6.9.7",
    "@google-cloud/storage": "^7.5.0",
    "stripe": "^14.5.0",
    "socket.io": "^4.7.4",
    "@tensorflow/tfjs-node": "^4.13.0",
    "natural": "^6.12.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "fitness",
    "nutrition",
    "health",
    "tracking",
    "api",
    "backend"
  ],
  "author": "Trego Team",
  "license": "MIT"
}